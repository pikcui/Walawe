# Copy to .env and edit. Never commit .env.
# Use URL-safe characters in the password (it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me-dev-only

WALAWE_GATEWAY_ADDR=:8080
WALAWE_LOG_LEVEL=info
WALAWE_HOLD_TTL_SECONDS=300
WALAWE_DEFAULT_MARGIN_BPS=0

# Used from stage 1 onward (not read by the stage 0 gateway):
# WALAWE_DATABASE_URL=postgres://walawe:<password>@localhost:5432/walawe?sslmode=disable
# WALAWE_REDIS_URL=redis://localhost:6379
# WALAWE_NATS_URL=nats://localhost:4222
# WALAWE_OTEL_ENDPOINT=
